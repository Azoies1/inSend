# Copy to .env (git-ignored) and fill in. Empty values fall back to the
# sandbox/local defaults in backend/src/config.ts. Never put real credentials
# in this file.

# HTTP server
PORT=
HOST=

# Postgres. Empty = the local Docker Compose database.
DATABASE_URL=

# Which payment adapter runs behind the PaymentProvider interface.
# One of: fake | rtr-sim | zum. Empty = fake.
PAYMENT_ADAPTER=

# Payments Canada RTR sandbox (Goal 2). From an App created under My Apps on
# developer.payments.ca with the RTR Sandbox API product. Sandbox keys only.
RTR_CONSUMER_KEY=
RTR_CONSUMER_SECRET=
# Optional overrides; empty = sandbox defaults (see docs/rtr-notes.md). RTR_BASE_URL must be a
# sandbox URL: the adapter refuses anything else.
RTR_BASE_URL=
RTR_TOKEN_URL=
RTR_PARTICIPANT_ID=
RTR_DEBTOR_NAME=
RTR_DEBTOR_ACCOUNT=
RTR_REQUEST_TIMEOUT_MS=

# Zum Rails sandbox (Goal 3): added once its sandbox documentation is read.
