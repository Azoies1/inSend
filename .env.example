# Copy to .env (git-ignored) and fill in. Empty values fall back to the
# sandbox/local defaults in backend/src/config.ts. Never put real credentials
# in this file.

# HTTP server
PORT=
HOST=

# Postgres. Empty = the local Docker Compose database.
DATABASE_URL=

# Which payment adapter runs behind the PaymentProvider interface.
# One of: fake | rtr-sim | zum. Empty = fake.
PAYMENT_ADAPTER=

# Provider sandbox base URLs and credentials are added here in Goals 2 and 3,
# once their names are confirmed from each provider's sandbox documentation.
